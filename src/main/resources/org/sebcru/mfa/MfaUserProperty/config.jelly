<?jelly escape-by-default='false'?>
<!--
  Task 9 — the MFA factor-management SECTION for "Manage account → Security".

  WHERE THIS FILE LIVES (verified 2026-08-19 against jenkins-core 2.528.3):
  core's security-tab page (hudson/model/userproperty/UserPropertyCategorySecurityAction/index.jelly)
  includes each property's section via <st:include from="${d}" page="${d.configPage}"/> —
  i.e. RESOLVED RELATIVE TO THE DESCRIPTOR (Descriptor.getConfigPage() = "config" by default).
  So this file MUST be at <this class's package dir>/config.jelly, which for
  org.sebcru.mfa.MfaUserProperty is org/sebcru/mfa/MfaUserProperty/config.jelly.
  A file at the original plan's (wrong) org/sebcru/mfa/views/MfaUserProperty.jelly
  renders NOTHING and nothing in the build complains — the silent-failure trap
  the render-presence IT case exists to catch.

  BINDING (what the section can reference, from the core include scope):
    it         = the MfaUserProperty DESCRIPTOR   (non-null ALWAYS, even when a
                                    fresh user has no property yet) — the section's
                                    JS reads getMfaCrumbField/Value/BaseUrl off it.
    instance   = the user's BOUND MfaUserProperty (null for a fresh, not-yet-enrolled
                                    user) — MUST be null-guarded; it is the only
                                    object state is read from.
    descriptor = the descriptor (same as it) — used for the descriptor.enabled guard.
  The section is wrapped by core in <f:rowSet name="userProperty${index}"> inside ONE
  <f:form action="configSubmit">, so this file declares NO <form> and NO save button.
  doConfigSubmit (verified: targetUser.checkPermission(ADMINISTER) first) binds ONLY the
  registeredEmail field (@DataBoundSetter) — the TOTP seed NEVER travels configSubmit;
  it is committed by postEnrollConfirm (JSON endpoint) after a code is proven.

  escape-by-default='false' so the inline <script>/CSS survive verbatim (dynamic attribute
  values — mfaBaseUrl, mfaCrumbField/Value — are interpolated raw; <x:out> is not a tag on
  this runtime, per A18 — so dynamic TEXT uses j:out, dynamic ATTRIBUTES are raw ${...}, the
  same split the login page /mfa/index.jelly uses).
-->
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <j:if test="${descriptor.enabled}">
    <div id="mfaSection" class="mfa-section">
      <f:invisibleEntry>
        <!-- Dummy so the enclosing rowSet always carries an entry (core idiom,
             cf. ConsoleUrlProviderUserProperty/config.jelly). "unused" has no
             matching @DataBoundSetter and is deliberately ignored on submit. -->
        <f:checkbox field="unused" checked="true"/>
      </f:invisibleEntry>

      <div class="jenkins-section__description">
        Multi-factor authentication for this account. Add or remove a TOTP
        authenticator-app factor and an optional email one-time-code factor.
        Changes take effect immediately — a removed factor stops working at once,
        so an account with neither factor relies on password only until
        re-enrolled.
      </div>

      <div id="mfaMsg" class="mfa-msg" role="alert"></div>

      <!-- ==================== TOTP ==================== -->
      <div class="mfa-factor mfa-factor-totp">
        <div class="mfa-factor__title">Authenticator app (TOTP)</div>
        <j:if test="${instance == null or !instance.hasTotpFactor()}">
          <div class="mfa-factor__status mfa-factor__status--off">Not enabled</div>
          <div>
            <button type="button" id="mfaTotpGenerate" class="mfa-btn">Generate new code</button>
          </div>
          <!-- (the QR + manual-secret + confirm row is #mfaTotpEnroll below;
               the JS reveals it after a successful "Generate new code" POST.) -->
        </j:if>
        <j:choose>
          <j:when test="${instance != null and instance.hasTotpFactor()}">
            <div class="mfa-factor__status mfa-factor__status--on">Enabled</div>
            <div>
              <button type="button" id="mfaTotpDisable" class="mfa-btn mfa-btn--danger">Disable this factor</button>
            </div>
            <div class="mfa-hint">
              To switch to a new phone: enable the new one below (it replaces
              the current factor) or disable this one and re-enrol.
            </div>
          </j:when>
        </j:choose>
        <!-- Enrolment scratch — always present so the JS can show/hide it; revealed
             client-side after a successful postEnroll. Hidden until then. -->
        <div id="mfaTotpEnroll" class="mfa-enroll" hidden="hidden">
          <div class="mfa-hint">Scan this QR with your authenticator app (Authy, Google
            Authenticator, 1Password, …). The code it generates is verified before
            anything is saved. If your camera is not handy, enter the secret by hand:</div>
          <div class="mfa-qr-row">
            <img id="mfaTotpQr" alt="TOTP enrolment QR code"/>
            <div class="mfa-manual">
              <label for="mfaTotpManual">Secret (manual entry)</label>
              <code id="mfaTotpManual"></code>
              <label for="mfaTotpCode">Code from your app</label>
              <div class="mfa-code-row">
                <input type="text" id="mfaTotpCode" inputmode="numeric" pattern="[0-9]{6}"
                       maxlength="6" placeholder="••••••" autocomplete="off"/>
                <button type="button" id="mfaTotpConfirm" class="mfa-btn mfa-btn--primary">Confirm &amp; enable</button>
              </div>
            </div>
          </div>
          <div>
            <button type="button" id="mfaTotpRegenerate" class="mfa-btn mfa-btn--ghost">Use a different code</button>
          </div>
        </div>
        <!-- Hidden seed + otpauth URI carried between "Generate" and "Confirm".
             The single-POST commit keeps the unproven seed ONLY here (user's own
             form); it is written to the property ONLY by postEnrollConfirm after
             a correct code. -->
        <input type="hidden" id="mfaTotpSeed" value=""/>
      </div>

      <div class="mfa-divider"></div>

      <!-- ==================== Email ==================== -->
      <div class="mfa-factor mfa-factor-email">
        <div class="mfa-factor__title">Email one-time codes</div>
        <f:entry field="registeredEmail" title="Registered address"
                 description="One-time sign-in codes are always mailed to this address — the only place they go.">
          <!-- field= self-binds to instance.registeredEmail; for a not-enrolled
               user (a blank property) it renders empty and submits blank. No
               manual value= — that would try to read from a possibly-null instance. -->
          <f:textbox field="registeredEmail"/>
        </f:entry>
        <j:choose>
          <j:when test="${instance != null and instance.hasEmailFactor()}">
            <div class="mfa-factor__status mfa-factor__status--on">Enabled — codes go to
              <b><j:out value="${instance.maskedRegisteredEmail()}" /></b></div>
            <div class="mfa-email-actions">
              <button type="button" id="mfaEmailTestCode" class="mfa-btn">Send a test code</button>
              <button type="button" id="mfaEmailDisable" class="mfa-btn mfa-btn--danger">Disable this factor</button>
            </div>
          </j:when>
          <j:otherwise>
            <div class="mfa-factor__status mfa-factor__status--off">Not enabled — set a registered address above and save, then it becomes available.</div>
          </j:otherwise>
        </j:choose>
      </div>

      <div class="mfa-divider"></div>

      <!-- ==================== Manage ==================== -->
      <div class="mfa-factor mfa-factor-manage">
        <div class="mfa-factor__title">Remembered devices</div>
        <div class="mfa-hint">
          A successful sign-in normally remembers this browser for a while.
          Revoking here makes the NEXT sign-in from any browser ask for a second
          factor again (it does not log out your current session).
        </div>
        <div>
          <button type="button" id="mfaRevokeTrust" class="mfa-btn">Revoke remembered devices</button>
        </div>
      </div>

      <!-- ==================== Styles (scoped-ish) ==================== -->
      <style>
        .mfa-section { font-size: 13px; }
        .mfa-section__description { margin: 0 0 12px; color: var(--text-color-2, #767676); }
        .mfa-msg { min-height: 0; margin: 0 0 12px; padding: 0; }
        .mfa-msg.mfa-msg--ok { color: var(--success-color, #2f7d32); }
        .mfa-msg.mfa-msg--error { color: var(--error-color, #b3261e); }
        .mfa-msg:empty { display: none; }
        .mfa-factor { padding: 10px 0; border-top: 1px solid #f0f0f0; }
        .mfa-factor__title { font-weight: 600; margin-bottom: 6px; }
        .mfa-factor__status { font-size: 12px; margin-bottom: 8px; }
        .mfa-factor__status--on { color: var(--success-color, #2f7d32); }
        .mfa-factor__status--off { color: var(--text-color-2, #767676); }
        .mfa-hint { font-size: 12px; color: var(--text-color-3, #959595); margin: 8px 0; }
        .mfa-btn { cursor: pointer; }
        .mfa-btn--danger { background: var(--error-background, #fde9e8); color: var(--error-color, #b3261e); }
        .mfa-btn--primary { background: var(--primary-color, #1f6feb); color: #fff; border-color: var(--primary-color, #1f6feb); }
        .mfa-btn--ghost { background: transparent; }
        .mfa-enroll { margin-top: 12px; padding: 12px; background: var(--secondary-background, #fafafa); border: 1px solid #eee; }
        .mfa-qr-row { display: flex; gap: 16px; flex-wrap: wrap; align-items: flex-start; }
        .mfa-qr-row #mfaTotpQr { width: 220px; height: 220px; border: 1px solid #ddd; background: #fff; }
        .mfa-manual { flex: 1; min-width: 240px; }
        .mfa-manual label { display: block; margin-top: 8px; }
        .mfa-manual code { display: inline-block; padding: 4px 6px; background: #111; color: #e8eaed;
          word-break: break-all; font-size: 13px; letter-spacing: 1px; min-width: 220px; }
        .mfa-code-row { display: flex; gap: 8px; }
        .mfa-code-row input { font-family: monospace; font-size: 16px; letter-spacing: 4px; text-align: center;
          width: 120px; }
        .mfa-email-actions { display: flex; gap: 8px; margin-top: 8px; }
        .mfa-divider { height: 0; }
      </style>

      <script>
        //<![CDATA[
        (function () {
          "use strict";
          var CRUMB_NAME = "${it.mfaCrumbField}";
          var CRUMB = "${it.mfaCrumbValue}";
          var BASE = "${it.mfaBaseUrl}"; // e.g. "http://host:port/jenkins/mfa/"
          var section = document.getElementById("mfaSection");
          var msg = document.getElementById("mfaMsg");
          if (!section) { return; }
          function $(id) { return document.getElementById(id); }
          var totpEnroll = $("mfaTotpEnroll");
          var totpQr = $("mfaTotpQr");
          var totpManual = $("mfaTotpManual");
          var totpSeed = $("mfaTotpSeed");
          var totpCode = $("mfaTotpCode");

          var MESSAGES = {
            wrong_code: "That code did not match. Try the current 6-digit code from your app.",
            invalid_seed: "That code is no longer valid — generate a fresh one and try again.",
            email_not_enrolled: "Set and save a registered email address first.",
            resend_cooldown: "Please wait a moment before requesting another code.",
            not_enrolled: "That factor is not enabled on this account.",
            not_authenticated: "Your session looks off — reload the page and try again.",
            server_error: "Something went wrong on the server. Try again."
          };

          function showMsg(kind, text) {
            msg.className = "mfa-msg mfa-msg--" + kind;
            msg.textContent = text;
          }
          function clearMsg() { msg.className = "mfa-msg"; msg.textContent = ""; }

          function post(endpoint, payload) {
            var body = new URLSearchParams();
            if (CRUMB) { body.append(CRUMB_NAME, CRUMB); }
            for (var k in (payload || {})) { if (payload.hasOwnProperty(k)) { body.append(k, payload[k]); } }
            return fetch(BASE + endpoint, {
              method: "POST",
              credentials: "same-origin",
              headers: { "Content-Type": "application/x-www-form-urlencoded",
                         "X-Requested-With": "XMLHttpRequest" },
              body: body.toString()
            }).then(function (r) { return r.json(); })
              ["catch"](function () { return { ok: false, error: "server_error" }; });
          }

          function showEnrollUI() { if (totpEnroll) { totpEnroll.hidden = false; } }
          function hideEnrollUI() { if (totpEnroll) { totpEnroll.hidden = true; } }
          function clearEnroll() {
            if (totpQr) { totpQr.removeAttribute("src"); }
            if (totpManual) { totpManual.textContent = ""; }
            if (totpSeed) { totpSeed.value = ""; }
            if (totpCode) { totpCode.value = ""; }
            hideEnrollUI();
          }
          function refreshState() { window.location.reload(); }

          var genBtn = $("mfaTotpGenerate");
          function generate() {
            if (genBtn) { genBtn.disabled = true; }
            clearMsg();
            post("postEnroll", {}).then(function (res) {
              if (genBtn) { genBtn.disabled = false; }
              if (!res.ok) { showMsg("error", MESSAGES[res.error] || MESSAGES.server_error); return; }
              if (totpSeed) { totpSeed.value = res.seed || ""; }
              if (totpQr && res.dataUriPng) { totpQr.setAttribute("src", res.dataUriPng); }
              else if (totpQr) { totpQr.remove(); }
              if (totpManual) { totpManual.textContent = res.seed || ""; }
              showEnrollUI();
            })["catch"](function () {
              if (genBtn) { genBtn.disabled = false; }
              showMsg("error", MESSAGES.server_error);
            });
          }
          if (genBtn) { genBtn.addEventListener("click", generate); }
          var regenBtn = $("mfaTotpRegenerate");
          if (regenBtn) { regenBtn.addEventListener("click", function () { clearEnroll(); generate(); }); }

          var confirmBtn = $("mfaTotpConfirm");
          if (confirmBtn) {
            confirmBtn.addEventListener("click", function () {
              clearMsg();
              confirmBtn.disabled = true;
              post("postEnrollConfirm", { seed: totpSeed ? totpSeed.value : "", code: (totpCode.value || "").trim() })
                .then(function (res) {
                  if (res.ok) { refreshState(); return; }
                  confirmBtn.disabled = false;
                  showMsg("error", MESSAGES[res.error] || MESSAGES.server_error);
                })["catch"](function () { confirmBtn.disabled = false; showMsg("error", MESSAGES.server_error); });
            });
          }

          var disableTotp = $("mfaTotpDisable");
          if (disableTotp) {
            disableTotp.addEventListener("click", function () {
              if (!window.confirm("Disable authenticator-app MFA for this account? It stops working immediately.")) { return; }
              clearMsg();
              post("postDisableTotp", {}).then(function (res) {
                if (res.ok) { refreshState(); return; }
                showMsg("error", MESSAGES[res.error] || MESSAGES.server_error);
              })["catch"](function () { showMsg("error", MESSAGES.server_error); });
            });
          }

          var testCodeBtn = $("mfaEmailTestCode");
          if (testCodeBtn) {
            testCodeBtn.addEventListener("click", function () {
              clearMsg();
              testCodeBtn.disabled = true;
              post("postEmailTestCode", {}).then(function (res) {
                testCodeBtn.disabled = false;
                if (res.ok) { showMsg("ok", "A one-time code is on its way to your registered address."); return; }
                if (res.error === "resend_cooldown" && res.retrySeconds) {
                  showMsg("error", MESSAGES.resend_cooldown + " (about " + res.retrySeconds + "s)");
                  return;
                }
                showMsg("error", MESSAGES[res.error] || MESSAGES.server_error);
              })["catch"](function () { testCodeBtn.disabled = false; showMsg("error", MESSAGES.server_error); });
            });
          }

          var disableEmail = $("mfaEmailDisable");
          if (disableEmail) {
            disableEmail.addEventListener("click", function () {
              if (!window.confirm("Disable email-code MFA and clear the registered address?")) { return; }
              clearMsg();
              post("postDisableEmail", {}).then(function (res) {
                if (res.ok) { refreshState(); return; }
                showMsg("error", MESSAGES[res.error] || MESSAGES.server_error);
              })["catch"](function () { showMsg("error", MESSAGES.server_error); });
            });
          }

          var revokeBtn = $("mfaRevokeTrust");
          if (revokeBtn) {
            revokeBtn.addEventListener("click", function () {
              clearMsg();
              post("postRevokeTrust", {}).then(function (res) {
                if (res.ok) { showMsg("ok", "Remembered devices revoked — the next sign-in will ask for a second factor."); return; }
                showMsg("error", MESSAGES[res.error] || MESSAGES.server_error);
              })["catch"](function () { showMsg("error", MESSAGES.server_error); });
            });
          }
        })();
        //]]>
      </script>
    </div>
  </j:if>
</j:jelly>
