<?jelly escape-by-default='false'?>
<!--
  The A22-b admin page (MfaAdminController index view, mounted at
  <root>/mfaAdmin). A self-contained document exactly like the MFA
  verification page (index.jelly next door): no l:layout wrapper, so it
  must declare its own Content-Type (postmortem round 3), nosniff
  (round 2/3), ship its JS as a STATIC file (round 2 CSP rule — no inline
  scripts), and declare every element of the button palette explicitly —
  in BOTH schemes (round 7 white-on-white ghost buttons).

  Theming (§1-B, 2026-08-23): the page claims `color-scheme: light dark`
  and now honours it — the base rules are the dark theme and the
  `@media (prefers-color-scheme: light)` block re-paints every surface,
  so light and dark renders are genuinely different documents. Before
  the fix the light render was byte-identical to the dark one (the
  A22-b "both themes" screenshots shared an md5); MfaAdminIndexThemeTest
  pins the per-surface light declarations. The 403 denial arm carries its
  own light rules too, so the denial page is not a dark hole in a light UI.

  The view is deliberately DUMB: the controller's getRosterRows() is the
  render model (ruling 4: enrolled-only for now; A24's force-enrolment
  column will be a row-field addition). The verbs themselves are the two
  static-JS POSTs to clearFactors / revokeTrust — NOT wired here, because
  the page's JS must also enforce the typed-user-id confirmation (mads
  ruling 5: "100% user typed confirmation"), and the ENDPOINT re-checks
  that typed value server-side (UX and server-side are the same test).

  Privacy: the roster shows only the user id, display name, and the
  MASKED delivery address (A16). No plaintext registered mailbox ever
  reaches this DOM; the row's factor columns say which factors exist.
-->
<j:jelly xmlns:j="jelly:core" xmlns:x="jelly:xml" xmlns:st="jelly:stapler">
  <st:contentType value="text/html;charset=UTF-8"/>
  <st:setHeader name="Cache-Control" value="no-cache,no-store,must-revalidate"/>
  <st:setHeader name="X-Content-Type-Options" value="nosniff"/>
  <!--
    The page-level READ gate (Ruling 3, spec §4: ADMINISTER may READ the
    roster; the credential axis belongs to the verbs, not to the page).
    RootAction is not permission-gated by core — the view is, through this
    branch. The 403 body carries the stable token admin_permission_required
    (the surface's permission-denial vocabulary) so a strict consumer can
    distinguish it from a core 403 error page; the verbs keep the JSON
    envelope (spec-pinned).
  -->
  <j:choose>
    <j:when test="${!it.adminPageAllowed()}">
      <st:statusCode value="403"/>
      <x:doctype name="html"/>
      <html lang="en">
        <head>
          <meta charset="utf-8"/>
          <meta name="robots" content="noindex,nofollow"/>
          <title>403 Forbidden — MFA administration</title>
          <!-- §1-B (2026-08-23): the denial page is a surface of this face,
               so it follows the user's colour-scheme like the roster — no
               permanent dark sheet inside a light UI. -->
          <style>
            html, body { margin: 0; }
            body {
              min-height: 100vh;
              display: flex; align-items: center; justify-content: center;
              background: #101418;
              color: #e8eaed;
              font-family: sans-serif;
            }
            h1 { font-size: 18px; margin: 0 0 8px 0; }
            p { font-size: 14px; color: #9aa4ae; margin: 0; }
            .back {
              color: #6fb0d3;
              text-decoration: none;
              font-size: 13px;
            }
            .back:hover { text-decoration: underline; }
            code { font-family: monospace; }
            @media (prefers-color-scheme: light) {
              body {
                background: #ffffff;
                color: #1f2328;
              }
              p { color: #767676; }
              .back { color: #1a5dab; }
            }
          </style>
        </head>
        <body>
          <div>
            <p class="backline">
              <a class="back" href="${it.manageConsoleLink}">← Manage Jenkins</a>
            </p>
            <h1>403 — MFA administration</h1>
            <p>
              You do not have permission to view this page
              (<code>admin_permission_required</code>).
            </p>
          </div>
        </body>
      </html>
    </j:when>
    <j:otherwise>
  <x:doctype name="html"/>
  <html lang="en">
    <head>
      <meta charset="utf-8"/>
      <meta name="viewport" content="width=device-width, initial-scale=1"/>
      <meta name="robots" content="noindex,nofollow"/>
      <title>MFA administration — Jenkins</title>
      <style>
        :root { color-scheme: light dark; }
        * { box-sizing: border-box; }
        html, body { margin: 0; padding: 0; }
        body {
          font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
          min-height: 100vh;
          display: flex;
          align-items: center;
          justify-content: center;
          background: #101418;
          color: #e8eaed;
        }
        .card {
          width: 100%;
          max-width: 860px;
          margin: 24px;
          background: #1a1f24;
          border: 1px solid #2a3138;
          border-radius: 12px;
          padding: 28px 32px;
        }
        h1 {
          font-size: 20px;
          font-weight: 600;
          margin: 0 0 6px 0;
          color: #e8eaed;
        }
        .sub {
          font-size: 13px;
          color: #9aa4ae;
          margin: 0 0 20px 0;
        }
        table {
          width: 100%;
          border-collapse: collapse;
          font-size: 14px;
        }
        th {
          text-align: left;
          font-weight: 600;
          color: #9aa4ae;
          font-size: 12px;
          text-transform: uppercase;
          letter-spacing: 0.04em;
          padding: 8px 10px;
          border-bottom: 1px solid #2a3138;
        }
        td {
          padding: 10px;
          border-bottom: 1px solid #232a30;
          vertical-align: middle;
        }
        .mono {
          font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
          font-size: 13px;
        }
        .factor {
          display: inline-block;
          border-radius: 4px;
          padding: 2px 8px;
          font-size: 12px;
          font-weight: 600;
        }
        .factor-totp { background: #1f3a2d; color: #6fd39a; border: 1px solid #2c5a43; }
        .factor-email { background: #1f2e3a; color: #6fb0d3; border: 1px solid #2c4a5a; }
        .none { color: #5c6770; font-size: 12px; }
        .empty {
          text-align: center;
          color: #9aa4ae;
          padding: 28px 0;
          font-size: 14px;
        }
        /* D2 (2026-08-24): back link — the page was an island; this is the
           route off it. Colour is explicit per scheme below (round-7 /
           rule-12: never inherit a neighbouring rule's colour); target is
           ABSOLUTE per the context-safe script-URL precedent. */
        .back {
          color: #6fb0d3;
          font-size: 13px;
          text-decoration: none;
        }
        .back:hover { text-decoration: underline; }
        .backline { margin: 0 0 14px 0; }
        /* Explicit button colours in BOTH schemes (postmortem round 7:
           token names guessed white-on-white — the --btn-secondary-*
           family is declared by core's skin, but this is a standalone
           page with no skin context, so the colours are literal). */
        .btn {
          border-radius: 6px;
          font-size: 12px;
          font-weight: 600;
          padding: 6px 12px;
          cursor: pointer;
          border: 1px solid #3a444d;
          background: #2a333c;
          color: #e8eaed;
          margin-right: 6px;
        }
        .btn:hover { background: #323d47; }
        .btn-danger {
          border: 1px solid #5a2c2c;
          background: #3a1f1f;
          color: #e88;
        }
        .btn-danger:hover { background: #4a2626; color: #ffb3b3; }
        .btn:disabled { opacity: 0.45; cursor: default; }
        /* The typed-confirmation dialog (mads ruling 5). */
        .veil {
          position: fixed; inset: 0;
          background: rgba(0,0,0,0.55);
          display: flex; align-items: center; justify-content: center;
        }
        .dialog {
          background: #1a1f24;
          border: 1px solid #2a3138;
          border-radius: 10px;
          padding: 22px 26px;
          width: 420px;
          max-width: 92vw;
        }
        .dialog h2 {
          font-size: 15px; margin: 0 0 8px 0; color: #ffd7d7; font-weight: 600;
        }
        .dialog p {
          font-size: 13px; color: #9aa4ae; margin: 0 0 14px 0;
        }
        .dialog .target { color: #e8eaed; font-weight: 700; }
        .dialog input {
          width: 100%;
          padding: 9px 10px;
          border-radius: 6px;
          border: 1px solid #3a444d;
          background: #101418;
          color: #e8eaed;
          font-size: 14px;
          font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
          margin-bottom: 16px;
        }
        .dialog .row { text-align: right; }
        .result {
          font-size: 13px;
          padding: 8px 12px;
          border-radius: 6px;
          margin-top: 10px;
        }
        .result-ok { background: #1f3a2d; color: #6fd39a; border: 1px solid #2c5a43; }
        .result-err { background: #3a1f1f; color: #e88; border: 1px solid #5a2c2c; }
        noscript { color: #e88; font-size: 13px; display: block; margin-top: 12px; }
        /* A24: rollout sections, counts, account labels, force-enrol controls */
        .section-h {
          font-size: 15px; font-weight: 600; color: #e8eaed;
          margin: 26px 0 8px 0;
        }
        .count-pill {
          display: inline-block; min-width: 22px; text-align: center;
          background: #232a30; border: 1px solid #3a444d; border-radius: 10px;
          padding: 1px 8px; font-size: 12px; color: #9aa4ae;
        }
        .acct {
          display: inline-block; border-radius: 4px; padding: 1px 7px;
          font-size: 11px; font-weight: 600; text-transform: uppercase;
        }
        .acct-active { background: #1f3a2d; color: #6fd39a; }
        .acct-disabled { background: #3a1f1f; color: #e88; }
        .acct-unknown { background: #2a333c; color: #9aa4ae; }
        .mailbox {
          padding: 6px 8px; border-radius: 6px; border: 1px solid #3a444d;
          background: #101418; color: #e8eaed; font-size: 12px; width: 180px;
        }
        .btn-force {
          border: 1px solid #2c4a5a; background: #1f2e3a; color: #6fb0d3;
        }
        .btn-force:hover { background: #26404f; }

        /* ============ LIGHT THEME (§1-B, 2026-08-23) ============
           The base rules above are the DARK theme. This block re-paints
           EVERY painted surface for light-preferring browsers, following
           the house light palette already established in the self-service
           MFA section (MfaUserProperty/config.jelly: #1f2328 text,
           #f8f9fa buttons, #d0d7de borders, #2f7d32 success, #b3261e
           error). Before this block existed, the page declared
           `color-scheme: light dark` but rendered byte-identically dark
           under a light preference — the A22-b "both themes" screenshots
           03/04 shared one md5. MfaAdminIndexThemeTest pins these
           declarations surface by surface. */
        @media (prefers-color-scheme: light) {
          body {
            background: #ffffff;
            color: #1f2328;
          }
          .card {
            background: #ffffff;
            border: 1px solid #d0d7de;
          }
          h1 { color: #1f2328; }
          .sub { color: #767676; }
          th { color: #767676; border-bottom: 1px solid #d0d7de; }
          td { border-bottom: 1px solid #eaeef2; }
          .none { color: #8c959f; }
          .back { color: #1a5dab; }
          .factor-totp { background: #e6f4ea; color: #1e7e34; border: 1px solid #a8d5b5; }
          .factor-email { background: #e7f0fa; color: #1a5dab; border: 1px solid #a3c2e0; }
          .btn {
            border: 1px solid #d0d7de;
            background: #f8f9fa;
            color: #1f2328;
          }
          .btn:hover { background: #eef1f4; }
          .btn-danger {
            border: 1px solid #f3b0ad;
            background: #fde9e8;
            color: #b3261e;
          }
          .btn-danger:hover { background: #fbdbd9; color: #8c1d18; }
          .veil { background: rgba(15, 23, 42, 0.32); }
          .dialog {
            background: #ffffff;
            border: 1px solid #d0d7de;
          }
          .dialog h2 { color: #7e1e1b; }
          .dialog p { color: #767676; }
          .dialog .target { color: #1f2328; }
          .dialog input {
            border: 1px solid #d0d7de;
            background: #ffffff;
            color: #1f2328;
          }
          .result-ok { background: #e6f4ea; color: #1e7e34; border: 1px solid #a8d5b5; }
          .result-err { background: #fde9e8; color: #b3261e; border: 1px solid #f3b0ad; }
          noscript { color: #b3261e; }
          .section-h { color: #1f2328; }
          .count-pill { background: #eaeef2; border-color: #d0d7de; color: #767676; }
          .acct-active { background: #e6f4ea; color: #1e7e34; }
          .acct-disabled { background: #fde9e8; color: #b3261e; }
          .acct-unknown { background: #eef1f4; color: #767676; }
          .mailbox { border-color: #d0d7de; background: #ffffff; color: #1f2328; }
          .btn-force { border-color: #a3c2e0; background: #e7f0fa; color: #1a5dab; }
          .btn-force:hover { background: #d8e7f7; }
        }
      </style>
    </head>
    <body>
      <div class="card">
        <p class="backline">
          <a class="back" href="${it.securityConfigLink}">← Security
              configuration</a>
        </p>
        <h1>MFA administration</h1>
        <p class="sub">
          Rollout views. Clearing factors is the lockout recovery (the user can
          self-enrol again); revoking trust forces a re-verify at their next
          login; force enrol writes an email factor and REQUIRES the user to
          verify at their next login — it never verifies them. Every verb
          requires typing the target's user id.
        </p>
        <noscript>JavaScript is required to perform factor operations; the roster is shown read-only.</noscript>

        <!-- ============ ENROLLED (recovery roster) ============ -->
        <h2 class="section-h">Enrolled <span class="count-pill">${it.enrolledCount}</span></h2>
        <j:choose>
          <j:when test="${it.rosterRows.isEmpty()}">
            <div class="empty">No enrolled users.</div>
          </j:when>
          <j:otherwise>
            <table id="adminRoster">
              <thead>
                <tr>
                  <th>User</th><th>Account</th><th>Delivery address</th><th>Factors</th><th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <j:forEach var="row" items="${it.rosterRows}">
                  <tr data-user-id="${row.userId}" data-display="${row.displayName}">
                    <td class="mono"><j:out value="${row.userId}"/></td>
                    <td><span class="acct acct-${row.accountState}"><j:out value="${row.accountState}"/></span></td>
                    <td class="mono"><j:out value="${row.maskedMail}"/></td>
                    <td>
                      <j:if test="${row.isTotp()}"><span class="factor factor-totp">TOTP</span></j:if>
                      <j:if test="${row.isEmail()}"><span class="factor factor-email">EMAIL</span></j:if>
                      <j:if test="${!row.isTotp() and !row.isEmail()}"><span class="none">none</span></j:if>
                    </td>
                    <td>
                      <button type="button" class="btn btn-danger"
                              data-op="clearFactors"
                              data-user-id="${row.userId}"
                              data-display="${row.displayName}">Clear factors</button>
                      <button type="button" class="btn"
                              data-op="revokeTrust"
                              data-user-id="${row.userId}"
                              data-display="${row.displayName}">Revoke trust</button>
                    </td>
                  </tr>
                </j:forEach>
              </tbody>
            </table>
          </j:otherwise>
        </j:choose>

        <!-- ============ SETUP PENDING ============ -->
        <h2 class="section-h">Setup pending <span class="count-pill">${it.setupPendingCount}</span></h2>
        <j:choose>
          <j:when test="${it.setupPendingRows.isEmpty()}">
            <div class="empty">No users are waiting to finish setup.</div>
          </j:when>
          <j:otherwise>
            <table class="rosterTable">
              <thead>
                <tr><th>User</th><th>Account</th><th>Delivery address</th><th>Factors</th><th>Actions</th></tr>
              </thead>
              <tbody>
                <j:forEach var="row" items="${it.setupPendingRows}">
                  <tr>
                    <td class="mono"><j:out value="${row.userId}"/></td>
                    <td><span class="acct acct-${row.accountState}"><j:out value="${row.accountState}"/></span></td>
                    <td class="mono"><j:out value="${row.maskedMail}"/></td>
                    <td>
                      <j:if test="${row.isTotp()}"><span class="factor factor-totp">TOTP</span></j:if>
                      <j:if test="${row.isEmail()}"><span class="factor factor-email">EMAIL</span></j:if>
                      <j:if test="${!row.isTotp() and !row.isEmail()}"><span class="none">none</span></j:if>
                    </td>
                    <td>
                      <!-- A24 review fix: a setup-pending user carries a live
                           forced email factor but has NOT verified — if they
                           lose mailbox access pre-verify they are stranded
                           under REQUIRED. clearFactors (which also clears the
                           marker, D8) is their recovery path; same typed-id
                           confirmation UX as the enrolled roster. -->
                      <button type="button" class="btn btn-danger"
                              data-op="clearFactors"
                              data-user-id="${row.userId}"
                              data-display="${row.displayName}">Clear factors</button>
                    </td>
                  </tr>
                </j:forEach>
              </tbody>
            </table>
          </j:otherwise>
        </j:choose>

        <!-- ============ NOT ENROLLED (REQUIRED only, D9) ============ -->
        <j:if test="${it.complementVisible}">
          <h2 class="section-h">Not enrolled <span class="count-pill">${it.notEnrolledCount}</span></h2>
          <p class="sub">Force enrol provisions an EMAIL factor from a mailbox you enter.
            The user must verify a code sent there before Jenkins lets them in.</p>
          <j:choose>
            <j:when test="${it.notEnrolledRows.isEmpty()}">
              <div class="empty">Everyone is enrolled or pending — nothing to force.</div>
            </j:when>
            <j:otherwise>
              <table class="rosterTable">
                <thead>
                  <tr><th>User</th><th>Account</th><th>Delivery address</th><th>Factors</th><th>Actions</th></tr>
                </thead>
                <tbody>
                  <j:forEach var="row" items="${it.notEnrolledRows}">
                    <tr data-user-id="${row.userId}" data-display="${row.displayName}"
                        data-acct-state="${row.accountState}">
                      <td class="mono"><j:out value="${row.userId}"/></td>
                      <td><span class="acct acct-${row.accountState}"><j:out value="${row.accountState}"/></span></td>
                      <td class="mono"><j:out value="${row.maskedMail}"/></td>
                      <td><span class="none">none</span></td>
                      <td>
                        <input type="text" class="mailbox" placeholder="name@example.com"
                               autocomplete="off" spellcheck="false"
                               data-mailbox-for="${row.userId}"/>
                        <button type="button" class="btn btn-force"
                                data-op="forceEnrol"
                                data-user-id="${row.userId}"
                                data-display="${row.displayName}">Force enrol</button>
                      </td>
                    </tr>
                  </j:forEach>
                </tbody>
              </table>
            </j:otherwise>
          </j:choose>
        </j:if>
        <div id="adminResult" style="display:none"/>
      </div>
      <!-- JS config via data attributes (the house pattern from mfa-section.js):
           the script reads exactly these, nothing else. -->
      <div id="mfaAdminConfig"
           data-base="${it.mfaAdminBaseUrl}"
           data-crumb-field="${it.crumbField}"
           data-crumb-value="${it.crumbValue}"></div>
      <script src="${it.adminScriptUrl}"></script>
    </body>
  </html>
  </j:otherwise>
  </j:choose>
</j:jelly>
