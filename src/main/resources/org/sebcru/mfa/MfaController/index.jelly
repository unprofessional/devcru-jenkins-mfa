<?jelly escape-by-default='false'?>
<!--
  The MFA second-factor page (MfaController index view, mounted at
  <root>/mfa — moved off /securityRealm by Task 8's Defect B ruling: under a
  ModelObject-backed local realm (HPSR, the live box's shape) the realm's
  own mount squats the securityRealm top-level node and swallowed this
  page (Stapler 404 for /mfa under the realm).).

  Single form: one code field for either a 6-digit TOTP or an 8-character
  email code; when the email factor is enrolled, a "send code" action with a
  visible cooldown countdown. Both POSTs carry the core CSRF crumb; both
  ALSO carry the gate's ?redirect= parameter (A3: it is the canonical
  "back to where you were" carrier — Referer alone is the MFA page's own
  URL on a form POST, which would re-prompt the user after a success). Both
  return JSON. On success the page navigates to the server-validated
  redirect target from the JSON (never the raw Referer or raw parameter) —
  the "no dead redirect / no open redirect" fix.

  escape-by-default='false' so the inline script/style text
  survives verbatim (default escaping would XML-mangle the JS, where '&amp;'
  is a syntax error); the two dynamic TEXT values (masked email, issuer) are
  escaped by Jelly's own j:out (jelly:core) — the x:out tag that used to sit
  in those spots is not a tag on this runtime (the Task 8 IT caught the 500:
  "<x:out> This tag does not understand the 'value' attribute"). The crumb
  attribute is interpolated raw, exactly as core's own crumb-bearing views
  (signup.jelly, authenticate-security-token.jelly) do — the default crumb
  token is base62, never XML-special, and an attribute value cannot itself
  contain a nested tag. The script body is
  wrapped in the standard //<![CDATA[ ... //]]> fence: it is required for
  the XML (Jelly) side because the JS contains raw '&lt;' comparisons, and in
  the browser the fence reads as an ordinary line comment.
  Self-contained page: no external CSS/JS/CDN, no core layout dependency.
-->
<j:jelly xmlns:j="jelly:core" xmlns:x="jelly:xml" xmlns:st="jelly:stapler">
  <st:setHeader name="Cache-Control" value="no-cache,no-store,must-revalidate"/>
  <st:setHeader name="X-Content-Type-Options" value="nosniff"/>
  <x:doctype name="html"/>
  <html lang="en">
    <head>
      <meta charset="utf-8"/>
      <meta name="viewport" content="width=device-width, initial-scale=1"/>
      <meta name="robots" content="noindex,nofollow"/>
      <title>MFA verification — Jenkins</title>
      <style>
        :root { color-scheme: light dark; }
        * { box-sizing: border-box; }
        html, body { margin: 0; padding: 0; }
        body {
          font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
          min-height: 100vh;
          display: flex;
          align-items: center;
          justify-content: center;
          background: #0b0d12;
          color: #e8eaed;
          padding: 24px;
        }
        .card {
          width: 100%;
          max-width: 420px;
          background: #161a22;
          border: 1px solid #232836;
          border-radius: 12px;
          padding: 28px 28px 24px;
          box-shadow: 0 12px 40px rgba(0,0,0,0.45);
        }
        h1 { font-size: 18px; margin: 0 0 4px; font-weight: 600; }
        .sub { font-size: 13px; color: #9aa4b2; margin: 0 0 22px; }
        label { display: block; font-size: 13px; color: #c3cad4; margin-bottom: 6px; }
        .code { display: flex; gap: 8px; }
        .code input[type=text] {
          flex: 1;
          font-size: 20px;
          letter-spacing: 4px;
          text-align: center;
          padding: 12px 10px;
          border-radius: 8px;
          border: 1px solid #2f3748;
          background: #0f1218;
          color: #e8eaed;
          font-variant-numeric: tabular-nums;
        }
        .code input[type=text]:focus { outline: none; border-color: #4b8cff; }
        .btn {
          font-size: 14px;
          font-weight: 600;
          padding: 12px 16px;
          border-radius: 8px;
          border: 1px solid transparent;
          cursor: pointer;
        }
        .btn-primary { background: #1f6feb; color: #ffffff; }
        .btn-primary:disabled { background: #223355; color: #7d8696; cursor: not-allowed; }
        .btn-ghost { background: transparent; color: #8ab4ff; border-color: #2f3a55; }
        .btn-ghost:disabled { color: #6a7280; border-color: #232836; cursor: not-allowed; }
        .msg { font-size: 13px; margin: 0 0 16px; min-height: 18px; }
        .msg.error { color: #ff8a8a; }
        .msg.ok { color: #7ee39a; }
        .msg.hidden { visibility: hidden; }
        .divider { display: flex; align-items: center; gap: 12px; color: #5b6473; font-size: 12px; margin: 20px 0; }
        .divider::before, .divider::after { content: ""; height: 1px; background: #232836; flex: 1; }
        .email .who { font-size: 13px; color: #c3cad4; margin: 0 0 8px; }
        .email .who b { color: #ffffff; font-family: monospace; font-weight: 600; }
        .row { display: flex; gap: 10px; align-items: center; }
        .count { font-size: 13px; color: #9aa4b2; font-variant-numeric: tabular-nums; }
        .hint { font-size: 12px; color: #5b6473; margin: 14px 0 0; line-height: 1.5; }
      </style>
    </head>
    <body>
      <div class="card">
        <h1>MFA verification — <j:out value="${it.issuer}"/></h1>
        <p class="sub">Enter a code to finish signing in to Jenkins.</p>

        <div id="msg" class="msg hidden" role="alert"></div>

        <form id="verifyForm" autocomplete="off" novalidate="novalidate">
          <label for="code">Verification code</label>
          <div class="code">
            <input type="text" id="code" name="code" inputmode="numeric"
                   pattern="[0-9]{6}|[2-9A-HJ-NP-Z]{8}" maxlength="9"
                   placeholder="••••••" autofocus="autofocus"/>
            <button type="submit" id="verifyBtn" class="btn btn-primary">Verify</button>
          </div>
          <input type="hidden" name="${it.crumbField}" value="${it.crumbValue}"/>
        </form>

        <div class="divider">or</div>

        <j:if test="${it.hasEmailFactor()}">
          <div class="email">
            <p class="who">Send a one-time code to
              <b><j:out value="${it.maskedEmail}"/></b></p>
            <div class="row">
              <button type="button" id="resendBtn" class="btn btn-ghost">Send code</button>
              <span id="cooldown" class="count" hidden="hidden"></span>
            </div>
          </div>
        </j:if>
        <j:if test="${!it.hasEmailFactor()}">
          <p>
            No email factor is enrolled for this account — use your
            authenticator app above. Sign in and use your security profile to
            add email-code MFA.
          </p>
        </j:if>

        <p class="hint">5 wrong codes inside 30 minutes locks this account for
          15 minutes. A successful check remembers this browser for the
          configured window.</p>
      </div>

      <script src="${it.gateScriptUrl}"></script>
    </body>
  </html>
</j:jelly>
